
<div class="two-column-text-section home-row header-right not-mobile">
    <div class="two-column-text">
        {{ section.settings.text }}
    </div>
    <div class="two-column-header">
        {{ section.settings.header }}
    </div>
</div>
{% schema %}
{
"name": "Two Column, Header Right",
"settings": [
{
"id": "header",
"type": "text",
"label": "Row Header",
"default": "Lawrence Jeffrey"
},
{
"id": "text",
"type": "richtext",
"label": "Add custom text below",
"default": "<p>Add your text here</p>"
}
],
"presets": [
{
"name": "Header Right",
"category": "Custom"
}
]
}
{% endschema %}