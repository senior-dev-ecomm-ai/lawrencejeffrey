
<section class="Section {{ section.settings.css_class }}">
  
   <div class="four_class featured_blocks">
    {%- for block in section.blocks -%} 
      <div class="slider_product">
         {% if block.settings.pro_img != blank %}
           <div class="pro_img">
             <img class="lazy" src="{{ block.settings.pro_img | img_url: 'master'}}">
          </div>  
         {% endif %}
      
        {% if block.settings.pro_title != blank %}
           <div class="pro_title">{{ block.settings.pro_title  }}</div>  
         {% endif %}

        {% if block.settings.btn_text != blank %}
         
          <div class="btn_block">
          {% if block.settings.button_link != blank %}
            <a href="{{ block.settings.button_link }}" class="global-button">
           {% endif %}
              {{ block.settings.btn_text }}
          {% if block.settings.button_link != blank %}
            </a>
          {% endif %}
          </div>
                  
        {% endif %}
        
      </div>
    {% endfor %}
   </div>
  
</section>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.3.15/slick.css">
<link rel="stylesheet" href="{{ 'slick-1.css' | asset_url }}">
<script type="text/javascript" src="//code.jquery.com/jquery-migrate-1.2.1.min.js"></script>
<script type="text/javascript" src="{{ 'slick.min.js' | asset_url }}"></script>


<script>  
  jQuery(document).ready(function($) {
      $('.four_class').slick({
        dots: false,
        infinite: true,
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: true
    });
});

</script>

{% schema %}
  {
  "name": "Image Slider",
  "class": "shopify-section--image-with-text-overlay",
  "settings": [
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "Image",
      "name": "img",
        "settings": [
          {
            "type": "image_picker",
            "id": "pro_img",
            "label": "Product Image"
          },
          {
            "type": "html",
            "id": "pro_title",
            "label": "Title"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          },
          {
            "type": "text",
            "id": "btn_text",
            "label": "Button Text"
          }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Slider"        
    }
  ],
  "templates": [
     "page"
  ]
}
{% endschema %}

