{% if product.metafields.my_fields.size > 0 %}
<div class="product-specs blue_blocks">
  
  {% if product.metafields.my_fields.condition != blank %}
    <div class="specs-entry_details">
        <span class="spec-name">
            Condition:
        </span>
            <span class="spec-value">
                {{ product.metafields.my_fields.condition }}
            </span>
    </div>
  {% endif %}
   
