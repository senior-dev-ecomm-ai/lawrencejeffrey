
<div class="wishes_products card-wrapper"> 

  {% if page.handle contains "wishes"  %}
  <wish-list>
    {% assign wishlist = customer.metafields.custom.wishlist | append: '' %}
    {% if customer %}
      <span {% if wishlist contains product_card_product.id %}class="added-list"{% endif %} card-product data-wishlist-add="{{ product_card_product.id }}" data-company-id="{{ customer.current_company.id }}" data-customer-id="{{ customer.id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" stroke-width="3" stroke="currentColor" fill="none"><path d="M9.06,25C7.68,17.3,12.78,10.63,20.73,10c7-.55,10.47,7.93,11.17,9.55a.13.13,0,0,0,.25,0c3.25-8.91,9.17-9.29,11.25-9.5C49,9.45,56.51,13.78,55,23.87c-2.16,14-23.12,29.81-23.12,29.81S11.79,40.05,9.06,25Z"/></svg>
      </span>
    {% else %}
      <a href="/account/login"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" stroke-width="3" stroke="currentColor" fill="none"><path d="M9.06,25C7.68,17.3,12.78,10.63,20.73,10c7-.55,10.47,7.93,11.17,9.55a.13.13,0,0,0,.25,0c3.25-8.91,9.17-9.29,11.25-9.5C49,9.45,56.51,13.78,55,23.87c-2.16,14-23.12,29.81-23.12,29.81S11.79,40.05,9.06,25Z"/></svg></a>
    {% endif %}
  </wish-list>
  {% endif %}
     
     
  <div class="card-image product-recommendations__image">
      <a href="{{ product_card_product.url | default: '#' }}">

        {% if product_card_product.featured_media != nil %}
            <img src="{{ product_card_product.featured_media | img_url: '533x' }}"
                 alt="{{ product_card_product.featured_media.alt | escape }}"
                 loading="lazy"
                 class="motion-reduce">
        {% else %}
            <img src="https://via.placeholder.com/311x387/CCA43D/000000?text=Product+Placeholder+Image"
                 alt="{{ product_card_product.title }}"
                 loading="lazy"
                 class="motion-reduce">
        {%- endif -%}

      </a>
  </div>
  <div class="card-information wishes_info">
      <p class="card-information-text">{{ product_card_product.title }}</p>
  </div>

  <div class="wishes_price">
    <div class="wishes_sku">
      {%- assign current_variant = product_card_product.selected_or_first_available_variant -%}
      <p>#{{ current_variant.sku }}</p>     
    </div>
    
    {% if collection.handle contains "archive-jewelry" or collection.handle contains "archive-object" %}
      <div class="card-information-price">
          <p class="product-price">Sold</p>
      </div>
      {% elsif collection.handle contains "shop-the-sale-objets" or collection.handle contains "shop-the-sale" %}
      <div class="card-information-price 00">
           {% render 'card-price', product: product_card_product, price_class: '' %}
      </div>
    {% else %}
      <div class="card-information-price">    
           {% render 'price', product: product_card_product, price_class: '' %}
      </div>
    {% endif %}
  </div>
  
</div>
